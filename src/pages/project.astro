---
import FunkyLivingGraphic from "../components/FunkyLivingGraphic.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Project entry — Onkar Tambake"
  description="A project-detail route for verified, public engineering work by Onkar Tambake."
  activePage="work"
  mode="build"
  canonicalPath="/project.html"
  noindex
>
  <main id="main" class="route-page route-page--detail">
    <header class="detail-intro page-grid">
      <div>
        <h1 class="page-title">No project entry here.</h1>
        <p class="page-lede">This legacy URL does not identify a published case study. Project records use individual static pages when they are ready to share.</p>
        <a class="text-link" href="/work.html">Back to the workshop</a>
        <FunkyLivingGraphic id="legacy-project-path" variant="signal" label="This address does not identify a published project." />
      </div>
    </header>
  </main>
</BaseLayout>
