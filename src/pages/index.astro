---
import { getCollection } from "astro:content";
import ArchiveList from "../components/ArchiveList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { interests } from "../content/profile";

const projects = (await getCollection("projects", ({ data }) => data.public && data.status === "published"))
  .sort((a, b) => (b.data.publishedAt ?? b.data.date ?? 0).valueOf() - (a.data.publishedAt ?? a.data.date ?? 0).valueOf())
  .slice(0, 2);
const articles = (await getCollection("articles", ({ data }) => data.public && data.status === "published"))
  .sort((a, b) => (b.data.publishedAt ?? b.data.date ?? 0).valueOf() - (a.data.publishedAt ?? a.data.date ?? 0).valueOf())
  .slice(0, 2);
---

<BaseLayout
  title="Onkar Tambake — Build. Break. Understand."
  description="Onkar Tambake builds, investigates, and documents complex systems across engineering, security, and AI."
  activePage="home"
>
  <main id="main">
    <section class="hero page-grid" id="top" aria-labelledby="hero-title">
      <div class="hero__copy">
        <h1 class="hero-title" id="hero-title">
          <span>Build<span class="hero-title__period">.</span></span>
          <span>Break<span class="hero-title__period">.</span></span>
          <span class="hero-title__last">Understand<span class="hero-title__period">.</span></span>
        </h1>
        <p class="hero__intro">I’m Onkar Tambake. I build, investigate, and document complex systems — especially where software, security, and AI meet.</p>
        <div class="practice-lens">
          <div class="practice-lens__heading">
            <span>Choose a lens</span>
            <span data-mode-indicator>UNDERSTAND / TRACE / RECORD</span>
          </div>
          <div class="practice-switch" role="group" aria-label="Choose a practice lens">
            <button type="button" aria-pressed="false" data-mode-select="build">Build</button>
            <button type="button" aria-pressed="false" data-mode-select="break">Break</button>
            <button type="button" aria-pressed="true" data-mode-select="understand">Understand</button>
          </div>
          <p class="practice-lens__note" aria-live="polite" data-mode-copy>A trace is only useful when you can explain what it changed.</p>
        </div>
        <div class="hero__actions">
          <a class="text-link" href="/work.html">
            Explore the work
            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.5 9h10M9 4.5 13.5 9 9 13.5"></path></svg>
          </a>
          <a class="text-link text-link--quiet" href="/about.html">A little about me</a>
        </div>
      </div>

      <figure class="system-figure" aria-labelledby="system-title system-caption">
        <div class="system-figure__heading">
          <span id="system-title">A way of looking</span>
          <span class="system-figure__index">OBSERVE / TRACE / LEARN</span>
        </div>
        <svg class="system-map" viewBox="0 0 520 340" role="group" aria-labelledby="map-title map-desc">
          <title id="map-title">An illustrative system path</title>
          <desc id="map-desc">Select a point to inspect it. A request passes through a boundary into a system. A second path branches at the boundary for comparison.</desc>
          <defs>
            <pattern id="map-grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-opacity=".09" stroke-width="1"></path>
            </pattern>
            <marker id="map-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
              <path d="M0 0 10 5 0 10Z" fill="currentColor"></path>
            </marker>
          </defs>
          <rect class="system-map__ground" x="0" y="0" width="520" height="340" rx="2"></rect>
          <rect x="1" y="1" width="518" height="338" fill="url(#map-grid)"></rect>
          <path class="system-map__rail" d="M42 169H478"></path>
          <path class="system-map__route system-map__route--main" d="M42 169H151C180 169 180 104 212 104H318C348 104 344 169 376 169H478" marker-end="url(#map-arrow)"></path>
          <path class="system-map__route system-map__route--alternate" d="M151 169C181 169 180 246 212 246H318C349 246 344 169 376 169"></path>
          <g class="system-map__station" transform="translate(42 169)" role="button" tabindex="0" aria-label="Inspect the input" aria-pressed="false" data-map-node="input">
            <circle class="system-map__hit-area" r="18"></circle><circle class="system-map__node" r="6"></circle>
          </g>
          <g class="system-map__station" transform="translate(151 169)" role="button" tabindex="0" aria-label="Inspect the trust boundary" aria-pressed="false" data-map-node="boundary">
            <circle class="system-map__hit-area" r="18"></circle><circle class="system-map__node system-map__node--boundary" r="8"></circle>
          </g>
          <g class="system-map__station" transform="translate(265 104)" role="button" tabindex="0" aria-label="Inspect the system path" aria-pressed="false" data-map-node="system">
            <circle class="system-map__hit-area" r="18"></circle><circle class="system-map__node" r="6"></circle>
          </g>
          <g class="system-map__station" transform="translate(265 246)" role="button" tabindex="0" aria-label="Inspect the alternate branch" aria-pressed="false" data-map-node="branch">
            <circle class="system-map__hit-area" r="18"></circle><circle class="system-map__node" r="6"></circle>
          </g>
          <g class="system-map__station" transform="translate(376 169)" role="button" tabindex="0" aria-label="Inspect the system boundary" aria-pressed="false" data-map-node="exit">
            <circle class="system-map__hit-area" r="18"></circle><circle class="system-map__node" r="8"></circle>
          </g>
          <g class="system-map__station" transform="translate(478 169)" role="button" tabindex="0" aria-label="Inspect the output" aria-pressed="false" data-map-node="output">
            <circle class="system-map__hit-area" r="18"></circle><circle class="system-map__node" r="6"></circle>
          </g>
          <path class="system-map__boundary" d="M151 67v204"></path>
          <path class="system-map__fracture" d="m151 151-7 8 12 5-9 10"></path>
          <text class="system-map__label" x="34" y="145">INPUT</text>
          <text class="system-map__label" x="127" y="57">BOUNDARY</text>
          <text class="system-map__label" x="238" y="81">SYSTEM</text>
          <text class="system-map__label" x="445" y="145">OUTPUT</text>
          <text class="system-map__annotation" x="188" y="302">A path changes where a boundary is crossed.</text>
        </svg>
        <figcaption class="system-figure__caption" id="system-caption">
          <span>An illustrative model, not a project result.</span>
          <button class="trace-control" type="button" aria-pressed="false" aria-controls="system-map-state" data-trace-toggle>
            <span data-trace-label>Trace an alternate path</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5"></path></svg>
          </button>
        </figcaption>
        <p class="system-figure__state" id="system-map-state" aria-live="polite" data-trace-state>Follow a request through a boundary and into a system.</p>
      </figure>

      <div class="hero__foot">
        <p>Curiosity, made useful.</p>
        <a href="/now.html">
          What I’m exploring now
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3.5 9.5 8 14l4.5-4.5"></path></svg>
        </a>
      </div>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <h2 id="work-title">Selected work</h2>
        <p class="section-heading__note">Built things, carefully documented.</p>
      </div>
      {projects.length > 0 ? (
        <ArchiveList entries={projects} baseHref="/projects" />
      ) : (
        <div class="empty-record">
          <span class="empty-record__mark" aria-hidden="true">
            <svg viewBox="0 0 36 36"><path d="M5 18h26M18 5v26"></path><circle cx="18" cy="18" r="12"></circle></svg>
          </span>
          <div>
            <h3>The work log is being assembled.</h3>
            <p>No project details or outcomes were included in the material available for this site. Case studies will appear here when there is real work to document.</p>
          </div>
          <span class="empty-record__status">NO CASE STUDIES PUBLISHED</span>
        </div>
      )}
      <p class="route-more"><a class="text-link" href="/work.html">Enter the workshop</a></p>
    </section>

    <section class="section research-section" id="research" aria-labelledby="research-title">
      <div class="section-heading">
        <h2 id="research-title">Questions worth following</h2>
        <p class="section-heading__note">Areas of interest — not a list of claimed results.</p>
      </div>
      <div class="research-layout">
        <p class="research-intro">I’m drawn to the places where systems meet their limits: a trust boundary, an unexpected input, a chain of automated decisions.</p>
        <ul class="topic-list">
          {interests.flatMap((group) => group.topics).map((topic) => <li>{topic}</li>)}
        </ul>
      </div>
      <p class="route-more"><a class="text-link" href="/research.html">Visit the laboratory</a></p>
    </section>

    <section class="section writing-section" id="writing" aria-labelledby="writing-title">
      <div class="section-heading">
        <h2 id="writing-title">Notes from the work</h2>
        <p class="section-heading__note">Research, explanations, and things learned along the way.</p>
      </div>
      {articles.length > 0 ? (
        <ArchiveList entries={articles} baseHref="/writing" includeReadingTime />
      ) : (
        <div class="writing-empty">
          <p class="writing-empty__lead">Good notes make the next investigation better.</p>
          <p>No articles or public research notes have been supplied yet. When they are published, they’ll live here in a format made for reading.</p>
          <span class="writing-empty__label">WRITING / NOT YET PUBLISHED</span>
        </div>
      )}
      <p class="route-more"><a class="text-link" href="/writing.html">Open the journal</a></p>
    </section>

    <section class="section about-section" id="about" aria-labelledby="about-title">
      <div class="section-heading">
        <h2 id="about-title">A little context</h2>
        <p class="section-heading__note">The person behind the questions.</p>
      </div>
      <p class="route-more"><a class="text-link" href="/about.html">Read more about the engineer</a></p>
      <div class="about-layout">
        <p class="about-statement">Build what you’re curious about. Break it carefully. Understand what the result is telling you.</p>
        <div class="about-copy">
          <p>I’m Onkar Tambake. My interests span security engineering, artificial intelligence, software architecture, and technical experimentation.</p>
          <p>I don’t see building and investigation as separate practices. Making a system is one way to learn how it behaves; probing its edges is another. This site is where that work can take shape and where the useful parts can be shared.</p>
          <p>Specific experience and credentials are intentionally not listed until they can be verified and described accurately.</p>
        </div>
      </div>
    </section>

    <section class="section now-section" id="now" aria-labelledby="now-title">
      <div class="section-heading">
        <h2 id="now-title">Now</h2>
        <p class="section-heading__note">A small, updateable record of current attention.</p>
      </div>
      <div class="now-content">
        <p class="now-content__intro">The threads I keep returning to:</p>
        <ul>
          <li>How security assumptions change across system boundaries.</li>
          <li>What reliable, understandable agentic systems require.</li>
          <li>How to study complex software by building and testing focused experiments.</li>
        </ul>
        <p class="now-content__note">These are ongoing interests from the supplied brief. Specific active projects and dates have not been provided.</p>
      </div>
      <p class="route-more"><a class="text-link" href="/now.html">Step into the observatory</a></p>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="contact-section__copy">
        <h2 id="contact-title">Let’s compare notes.</h2>
        <p>Interested in engineering, research, or a question that deserves a closer look?</p>
      </div>
      <div class="contact-section__detail">
        <span class="contact-section__label">CONTACT ROUTE</span>
        <p>A public email address or profile link wasn’t included in the supplied information. Add a verified contact destination here before publishing.</p>
      </div>
    </section>
    <p class="contact-route page-grid"><a class="text-link" href="/contact.html">Visit the contact page</a></p>
  </main>
</BaseLayout>
