---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { countMarkdownWords, formatReadingTime } from "../../lib/content-utils";

export async function getStaticPaths() {
  const entries = (await getCollection("articles", ({ data }) => data.public && data.status === "published"))
    .sort((a, b) => (b.data.publishedAt ?? b.data.date ?? 0).valueOf() - (a.data.publishedAt ?? a.data.date ?? 0).valueOf());
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, articles: entries } }));
}

const { entry, articles } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const description = data.seo?.description ?? data.summary;
const publishedAt = data.publishedAt ?? data.date;
const readingTime = formatReadingTime(countMarkdownWords(entry.body ?? ""));
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const relatedArticles = data.related.flatMap((slug) => {
  const article = articles.find((candidate) => candidate.id === slug);
  return article && article.id !== entry.id ? [article] : [];
});
---

<BaseLayout
  title={`${data.title} — Writing — Onkar Tambake`}
  description={description}
  activePage="writing"
  ogType="article"
  image={data.seo?.image}
  canonicalPath={`/writing/${entry.id}`}
>
  <main id="main" class="route-page route-page--detail route-page--article">
    <header class="detail-intro page-grid">
      <div>
        <h1 class="page-title">{data.title}</h1>
        <p class="page-lede">{data.summary}</p>
        <a class="text-link" href="/writing.html">Back to the journal</a>
      </div>
    </header>
    <dl class="detail-meta">
      {data.category && <><dt>Category</dt><dd>{data.category}</dd></>}
      {publishedAt && <><dt>Published</dt><dd><time datetime={publishedAt.toISOString()}>{publishedAt.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time></dd></>}
      <dt>Reading time</dt><dd>{readingTime}</dd>
    </dl>
    {data.tags.length > 0 && <ul class="tag-list" aria-label="Article tags">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    <div class:list={["article-layout", contents.length > 0 && "article-layout--with-toc"]}>
      {contents.length > 0 && (
        <nav class="article-toc" aria-label="Table of contents">
          <h2>On this page</h2>
          <ol>
            {contents.map((heading) => (
              <li class:list={[heading.depth === 3 && "article-toc__nested"]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <article class="article-body">
        <Content />
      </article>
    </div>
    {data.references.length > 0 && (
      <section class="detail-section">
        <h2>References</h2>
        <ul class="detail-list">
          {data.references.map((reference) => (
            <li>
              {typeof reference === "string" ? reference : <a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title}</a>}
            </li>
          ))}
        </ul>
      </section>
    )}
    {relatedArticles.length > 0 && (
      <section class="detail-section" aria-labelledby="related-title">
        <h2 id="related-title">Related writing</h2>
        <ul class="detail-list">
          {relatedArticles.map((article) => (
            <li><a href={`/writing/${article.id}`}>{article.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
