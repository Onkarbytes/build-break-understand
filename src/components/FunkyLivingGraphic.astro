---
interface MotionItem {
  label: string;
  href?: string;
  note?: string;
}

interface Props {
  id: string;
  variant: "wordform" | "carousel" | "network" | "book" | "signal" | "routes";
  label: string;
  items?: MotionItem[];
}

const { id, variant, label, items = [] } = Astro.props;
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<figure
  id={id}
  class:list={["funky-living", `funky-living--${variant}`]}
  data-funky-motion
  data-motion-variant={variant}
  data-motion-index="0"
  data-motion-state="active"
  aria-labelledby={`${id}-caption`}
>
  <div
    class="funky-living__stage"
    data-motion-stage
    tabindex={variant === "routes" ? undefined : "0"}
    role={variant === "routes" ? undefined : "group"}
    aria-label={variant === "routes" ? undefined : `${label} Use the arrow keys or drag to explore.`}
    aria-hidden={variant === "routes" ? "true" : undefined}
  >
    {variant === "wordform" && (
      <div class="funky-wordform" aria-hidden="true">
        <span>BUILD</span>
        <span>BREAK</span>
        <span>UNDERSTAND</span>
        <svg viewBox="0 0 360 220" focusable="false">
          <path d="M22 110h316M180 20v180M66 54l228 112M66 166 294 54"></path>
          <circle cx="180" cy="110" r="52"></circle>
          <circle cx="180" cy="110" r="82"></circle>
        </svg>
      </div>
    )}

    {variant === "carousel" && items.length > 0 && (
      <div class="funky-carousel" role="group" aria-roledescription="carousel" aria-label={label}>
        <ol class="funky-carousel__track">
          {items.map((item, index) => (
            <li
              class="funky-carousel__item"
              data-motion-item
              data-index={index}
              aria-roledescription="slide"
              style={`--item-angle:${(index * 360) / items.length}deg;--item-angle-inverse:${(-index * 360) / items.length}deg`}
            >
              <span>{item.label}</span>
            </li>
          ))}
        </ol>
        <span class="funky-carousel__counter"><span data-motion-counter>01</span> / {String(items.length).padStart(2, "0")}</span>
      </div>
    )}

    {variant === "network" && (
      <svg class="funky-network" viewBox="0 0 520 300" aria-hidden="true" focusable="false">
        <ellipse class="funky-network__orbit funky-network__orbit--one" cx="260" cy="150" rx="190" ry="70"></ellipse>
        <ellipse class="funky-network__orbit funky-network__orbit--two" cx="260" cy="150" rx="150" ry="112" transform="rotate(-34 260 150)"></ellipse>
        <ellipse class="funky-network__orbit funky-network__orbit--three" cx="260" cy="150" rx="150" ry="112" transform="rotate(34 260 150)"></ellipse>
        <path class="funky-network__link" d="M94 150 260 62l166 88-166 88-166-88Z"></path>
        <circle class="funky-network__node funky-network__node--center" cx="260" cy="150" r="16"></circle>
        <circle class="funky-network__node" cx="94" cy="150" r="10"></circle>
        <circle class="funky-network__node funky-network__node--coral" cx="260" cy="62" r="10"></circle>
        <circle class="funky-network__node funky-network__node--violet" cx="426" cy="150" r="10"></circle>
        <circle class="funky-network__node" cx="260" cy="238" r="10"></circle>
      </svg>
    )}

    {variant === "book" && (
      <div class="funky-book" aria-hidden="true">
        <div class="funky-book__spine"></div>
        <div class="funky-book__page funky-book__page--left"></div>
        <div class="funky-book__page funky-book__page--right"></div>
        <div class="funky-book__leaf"></div>
        <span class="funky-book__registration">NO ENTRIES PUBLISHED</span>
      </div>
    )}

    {variant === "signal" && (
      <svg class="funky-signal" viewBox="0 0 520 250" aria-hidden="true" focusable="false">
        <path class="funky-signal__rail" d="M36 126h448"></path>
        <path class="funky-signal__path" d="M36 126h94l26-58 34 116 38-86 32 28h84"></path>
        <circle class="funky-signal__source" cx="36" cy="126" r="9"></circle>
        <circle class="funky-signal__destination" cx="484" cy="126" r="11"></circle>
        <path class="funky-signal__break" d="m406 118 9 8-9 8m16-16 9 8-9 8"></path>
      </svg>
    )}

    {variant === "routes" && (
      <svg class="funky-route-map" viewBox="0 0 520 180" aria-hidden="true" focusable="false">
        <path class="funky-route-map__rail" d="M30 90h460"></path>
        <path class="funky-route-map__path" d="M30 90h110c28 0 30-52 62-52h116c32 0 34 104 66 104h96"></path>
        <circle class="funky-route-map__node" cx="30" cy="90" r="7"></circle>
        <circle class="funky-route-map__node funky-route-map__node--accent" cx="202" cy="38" r="7"></circle>
        <circle class="funky-route-map__node" cx="384" cy="142" r="7"></circle>
        <circle class="funky-route-map__node funky-route-map__node--accent" cx="490" cy="142" r="7"></circle>
      </svg>
    )}
  </div>

  {variant === "carousel" && items.length > 1 && (
    <div class="funky-living__controls" role="group" aria-label={`${label} controls`}>
      <button type="button" data-motion-step="-1" aria-label="Previous item" disabled>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15 10H5m5-5-5 5 5 5"></path></svg>
      </button>
      <button type="button" data-motion-step="1" aria-label="Next item" disabled>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-5-5 5 5-5 5"></path></svg>
      </button>
    </div>
  )}

  {variant === "network" && items.length > 0 && (
    <div class="funky-living__nodes" role="group" aria-label={`${label} focus`}>
      {items.map((item) => (
        <button
          type="button"
          data-motion-focus={slugify(item.label)}
          aria-controls={`interest-${slugify(item.label)}`}
          aria-pressed="false"
          disabled
        >
          {item.label}
        </button>
      ))}
    </div>
  )}

  {variant === "book" && (
    <div class="funky-living__controls" role="group" aria-label="Journal page controls">
      <button type="button" data-motion-page aria-pressed="false" disabled>Turn a blank page</button>
    </div>
  )}

  {variant === "routes" && items.length > 0 && (
    <nav class="funky-living__route-nav" aria-label={label}>
      <ol class="funky-route-carousel">
        {items.map((item, index) => (
          <li
            class="funky-route-carousel__item"
            data-motion-item
            data-index={index}
          >
            <a href={item.href}>
              <span>{item.label}</span>
              {item.note && <small>{item.note}</small>}
            </a>
          </li>
        ))}
      </ol>
      <div class="funky-living__controls" role="group" aria-label={`${label} controls`}>
        <button type="button" data-motion-step="-1" aria-label="Previous route" disabled>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15 10H5m5-5-5 5 5 5"></path></svg>
        </button>
        <span data-motion-counter>01</span>
        <span aria-hidden="true">/ {String(items.length).padStart(2, "0")}</span>
        <button type="button" data-motion-step="1" aria-label="Next route" disabled>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-5-5 5 5-5 5"></path></svg>
        </button>
      </div>
    </nav>
  )}

  <figcaption id={`${id}-caption`} class="funky-living__caption">{label}</figcaption>
  <p class="sr-only" data-motion-status role="status" aria-live="polite">{label}</p>
</figure>

<script>
  import "../scripts/funky-living-visuals";
</script>

<style>
  .funky-living {
    --motion-ink: var(--ink);
    --motion-paper: var(--paper-bright);
    --motion-accent: var(--funky-acid);
    --motion-blue: var(--funky-cobalt);
    min-width: 0;
    margin: 0;
    color: var(--motion-ink);
  }

  :global(:root:not([data-presentation="funky"])) .funky-living {
    display: none;
  }

  .funky-living__stage {
    position: relative;
    display: grid;
    min-height: clamp(13rem, 27vw, 22rem);
    overflow: hidden;
    place-items: center;
    border-block: 1px solid var(--rule);
    background-color: var(--paper-shade);
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--ink) 8%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 8%, transparent) 1px, transparent 1px);
    background-size: 2rem 2rem;
    perspective: 900px;
    touch-action: pan-y;
    transform: perspective(900px) rotateX(var(--motion-tilt-y, 0deg)) rotateY(calc(var(--motion-tilt-x, 0deg) + var(--motion-rotation, 0deg)));
    transform-style: preserve-3d;
    transition: transform 180ms ease-out;
  }

  .funky-living__stage:focus-visible {
    outline: 2px solid var(--funky-acid);
    outline-offset: -4px;
  }

  .funky-living__caption {
    display: block;
    margin-top: 0.65rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .funky-living__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    margin-top: 0.7rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .funky-living__controls button {
    display: inline-grid;
    min-width: 2.5rem;
    min-height: 2.5rem;
    place-items: center;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-bright);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .funky-living__controls button:hover {
    background: var(--funky-acid);
    color: var(--funky-on-bright);
    transform: translateY(-2px);
  }

  .funky-living__controls button:disabled,
  .funky-living__nodes button:disabled {
    opacity: 0.62;
    cursor: not-allowed;
  }

  .funky-living__controls button:focus-visible,
  .funky-living__nodes button:focus-visible,
  .funky-route-carousel__item a:focus-visible {
    outline: 2px solid var(--funky-acid);
    outline-offset: 3px;
  }

  .funky-living__controls button svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .funky-wordform {
    position: relative;
    display: grid;
    width: min(100%, 28rem);
    gap: 0.05em;
    padding: 1.4rem;
    transform-style: preserve-3d;
  }

  .funky-wordform span {
    display: block;
    font-family: var(--sans);
    font-size: clamp(2.2rem, 6.2vw, 5.3rem);
    font-weight: 800;
    letter-spacing: -0.085em;
    line-height: 0.8;
    text-transform: uppercase;
    transform-origin: left center;
  }

  .funky-wordform span:nth-child(2) {
    color: var(--funky-coral-text);
    animation: bbu-word-hinge 7.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .funky-wordform span:nth-child(3) {
    color: var(--funky-cobalt-text);
    animation: bbu-word-hinge 7.5s 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .funky-wordform svg {
    position: absolute;
    inset: 5% 0 auto auto;
    width: min(55%, 15rem);
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--funky-violet);
    stroke-width: 1;
    opacity: 0.7;
    transform: translateZ(-2rem);
  }

  .funky-wordform svg circle:last-child {
    stroke-dasharray: 3 6;
    animation: bbu-orbit-dash 14s linear infinite;
  }

  .funky-carousel {
    position: relative;
    display: grid;
    width: 100%;
    min-height: clamp(13rem, 27vw, 22rem);
    place-items: center;
    overflow: hidden;
    perspective: 850px;
  }

  .funky-carousel__track {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    min-height: inherit;
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
    animation: bbu-carousel-turn 38s linear infinite;
  }

  .funky-carousel__item {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    width: min(15rem, 58vw);
    min-height: 7rem;
    place-items: center;
    padding: 1.25rem;
    border-block: 1px solid var(--rule);
    background: var(--paper-bright);
    color: var(--ink);
    text-align: center;
    transform:
      translate(-50%, -50%)
      rotateY(var(--item-angle))
      translateZ(clamp(7.5rem, 18vw, 13rem))
      rotateY(var(--item-angle-inverse));
    backface-visibility: hidden;
    opacity: 0.68;
    transition: opacity 240ms ease, border-color 240ms ease, color 240ms ease;
  }

  .funky-carousel__item[data-current="true"] {
    border-color: var(--funky-acid);
    color: var(--funky-cobalt-text);
    opacity: 1;
  }

  .funky-carousel__item span {
    font-family: var(--display);
    font-size: clamp(1.35rem, 2.7vw, 2rem);
    line-height: 1.05;
  }

  .funky-carousel__counter {
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .funky-network {
    width: min(100%, 34rem);
    height: auto;
    overflow: visible;
  }

  .funky-network__orbit {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.2;
  }

  .funky-network__orbit--two {
    stroke-dasharray: 3 6;
    animation: bbu-orbit-dash 20s linear infinite;
  }

  .funky-network__orbit--three {
    stroke-dasharray: 1 7;
    animation: bbu-orbit-dash 26s linear infinite reverse;
  }

  .funky-network__link {
    fill: none;
    stroke: var(--motion-accent);
    stroke-width: 1.4;
    stroke-dasharray: 5 5;
    animation: bbu-orbit-dash 9s linear infinite;
  }

  .funky-network__node {
    fill: var(--funky-acid);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .funky-network__node--center {
    fill: var(--motion-blue);
  }

  .funky-network__node--coral {
    fill: var(--funky-coral);
  }

  .funky-network__node--violet {
    fill: var(--funky-violet);
  }

  .funky-living__nodes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .funky-living__nodes button {
    min-height: 2.4rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.68rem;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .funky-living__nodes button[aria-pressed="true"] {
    border-color: var(--funky-acid);
    background: var(--funky-acid);
    color: var(--funky-on-bright);
  }

  .funky-book {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(70%, 25rem);
    min-height: 11rem;
    transform: rotate(-4deg) rotateY(-12deg);
    transform-style: preserve-3d;
  }

  .funky-book__page {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    background: var(--paper-bright);
    box-shadow: inset 0 0.5rem 1rem color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .funky-book__page--left {
    border-right: 0;
    border-radius: 0.3rem 0 0 0.2rem;
  }

  .funky-book__page--right {
    border-left: 1px solid var(--rule);
    border-radius: 0 0.3rem 0.2rem 0;
  }

  .funky-book__spine {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--ink) 32%, transparent);
    transform: translateX(-50%);
  }

  .funky-book__leaf {
    position: absolute;
    z-index: 1;
    inset: 0 0 0 50%;
    border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    border-radius: 0 0.3rem 0.2rem 0;
    background: var(--paper-bright);
    transform-origin: left center;
    animation: bbu-page-turn 8s ease-in-out infinite;
    backface-visibility: hidden;
  }

  .funky-living--book[data-page-turned="true"] .funky-book__leaf {
    animation: bbu-page-open 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .funky-living--book .funky-living__controls button {
    min-width: 10rem;
    border-radius: 0;
  }

  .funky-book__registration {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
  }

  .funky-living--book .funky-living__stage {
    min-height: 15rem;
  }

  .funky-signal {
    width: min(100%, 34rem);
    height: auto;
  }

  .funky-signal__rail,
  .funky-signal__path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .funky-signal__rail {
    stroke: color-mix(in srgb, var(--contact-ink) 32%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 7;
  }

  .funky-signal__path {
    stroke: var(--contact-ink);
    stroke-width: 2;
    stroke-dasharray: 1 9;
    animation: bbu-orbit-dash 7s linear infinite;
  }

  .funky-signal__source {
    fill: var(--motion-accent);
    stroke: var(--contact-ink);
    stroke-width: 2;
  }

  .funky-signal__destination {
    fill: none;
    stroke: var(--funky-coral);
    stroke-dasharray: 3 4;
    stroke-width: 2;
  }

  .funky-route-map {
    width: min(100%, 42rem);
    height: auto;
  }

  .funky-route-map__rail,
  .funky-route-map__path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .funky-route-map__rail {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .funky-route-map__path {
    stroke: var(--motion-blue);
    stroke-dasharray: 2 9;
    stroke-width: 2;
    animation: bbu-orbit-dash 10s linear infinite;
  }

  .funky-route-map__node {
    fill: var(--paper-bright);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .funky-route-map__node--accent {
    fill: var(--motion-accent);
  }

  .funky-signal__break {
    fill: none;
    stroke: var(--funky-coral);
    stroke-linecap: round;
    stroke-width: 2;
  }

  .funky-living__route-nav {
    display: grid;
    gap: 0.7rem;
  }

  .funky-route-carousel {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .funky-route-carousel__item {
    display: grid;
    align-items: center;
    padding: 1rem clamp(1rem, 3vw, 1.5rem);
    border-block: 1px solid var(--rule);
    background: var(--paper-bright);
    transition: border-color 220ms ease, transform 220ms ease;
  }

  .funky-living[data-enhanced="true"] .funky-route-carousel {
    position: relative;
    display: block;
    min-height: 7rem;
  }

  .funky-living[data-enhanced="true"] .funky-route-carousel__item {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transform: perspective(800px) rotateY(14deg) translateX(1rem);
    transition: opacity 300ms ease, transform 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .funky-living[data-enhanced="true"] .funky-route-carousel__item[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
    transform: perspective(800px) rotateY(0) translateX(0);
  }

  .funky-route-carousel__item:hover {
    border-color: var(--funky-acid);
    transform: translateX(0.2rem);
  }

  .funky-route-carousel__item a {
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .funky-route-carousel__item a > span {
    color: var(--funky-cobalt-text);
    font-family: var(--display);
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    line-height: 1;
  }

  .funky-route-carousel__item small {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .funky-living__route-nav .funky-living__controls {
    justify-content: space-between;
    margin-top: 0;
  }

  :global(:root[data-presentation="funky"]) .nav-dialog__aside svg path {
    stroke-dasharray: 4 5;
    animation: bbu-nav-trace 7s linear infinite;
  }

  [data-interest-row][data-focused="false"] {
    opacity: 0.38;
  }

  [data-interest-row] {
    transition: opacity 220ms ease;
  }

  :global(:root[data-presentation="funky"][data-mode="build"]) .funky-living__stage {
    --motion-accent: var(--funky-acid);
  }

  :global(:root[data-presentation="funky"][data-mode="break"]) .funky-living__stage {
    --motion-accent: var(--funky-coral);
  }

  .funky-living[data-motion-state="paused"] .funky-wordform *,
  .funky-living[data-motion-state="paused"] .funky-carousel__track,
  .funky-living[data-motion-state="paused"] .funky-book__leaf,
  .funky-living[data-motion-state="paused"] .funky-network__orbit,
  .funky-living[data-motion-state="paused"] .funky-network__link,
  .funky-living[data-motion-state="paused"] .funky-signal__path,
  .funky-living[data-motion-state="paused"] .funky-route-map__path {
    animation-play-state: paused;
  }

  @keyframes bbu-word-hinge {
    0%, 25%, 100% { transform: rotateX(0) translateZ(0); }
    36%, 63% { transform: rotateX(-86deg) translateZ(0.2rem); }
    75% { transform: rotateX(0) translateZ(0); }
  }

  @keyframes bbu-orbit-dash {
    to { stroke-dashoffset: -90; }
  }

