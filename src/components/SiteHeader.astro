---
interface Props {
  activePage: string;
}

const { activePage } = Astro.props;
const routes = [
  { id: "home", href: "/", title: "Home", note: "The map and the starting point" },
  { id: "about", href: "/about.html", title: "About", note: "The person behind the questions" },
  { id: "work", href: "/work.html", title: "Work", note: "Things made and how they work" },
  { id: "research", href: "/research.html", title: "Research", note: "Questions at the edges of systems" },
  { id: "writing", href: "/writing.html", title: "Writing", note: "Notes, breakdowns, and discoveries" },
  { id: "now", href: "/now.html", title: "Now", note: "What has my attention" },
  { id: "contact", href: "/contact.html", title: "Contact", note: "Compare notes" },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Onkar Tambake, home">
    <svg class="wordmark__mark" viewBox="0 0 42 42" aria-hidden="true">
      <path d="M21 3.5 38.5 21 21 38.5 3.5 21 21 3.5Z"></path>
      <path d="M13 21h16M21 13v16"></path>
    </svg>
    <span>Onkar Tambake</span>
  </a>
  <p class="header-note">Independent engineering &amp; research</p>
  <div class="header-tools">
    <button class="theme-toggle" type="button" aria-label="Switch to night mode" title="Switch to night mode" data-theme-toggle>
      <svg class="theme-toggle__sun" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="3.5"></circle>
        <path d="M10 1.5v2M10 16.5v2M18.5 10h-2M3.5 10h-2m14.5-6-1.4 1.4M5.4 14.6 4 16m12 0-1.4-1.4M5.4 5.4 4 4"></path>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M16.8 12.1A7.6 7.6 0 0 1 7.9 3.2a7.7 7.7 0 1 0 8.9 8.9Z"></path>
      </svg>
    </button>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-toggle__label" data-menu-label>Explore</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<dialog class="nav-dialog" id="site-nav" aria-labelledby="nav-title" data-nav-dialog>
  <div class="nav-dialog__frame">
    <div class="nav-dialog__header">
      <a class="wordmark wordmark--dialog" href="/" aria-label="Onkar Tambake, home">
        <svg class="wordmark__mark" viewBox="0 0 42 42" aria-hidden="true">
          <path d="M21 3.5 38.5 21 21 38.5 3.5 21 21 3.5Z"></path>
          <path d="M13 21h16M21 13v16"></path>
        </svg>
        <span>Onkar Tambake</span>
      </a>
      <p>Pick up a thread.</p>
      <button class="nav-close" type="button" aria-label="Close navigation" data-nav-close>
        <span>Close</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
      </button>
    </div>
    <div class="nav-dialog__body">
      <div class="nav-dialog__intro">
        <h2 id="nav-title">Where does curiosity take you?</h2>
        <p>Pick a section. Follow a question. Come back with a better one.</p>
        <span class="nav-dialog__mode" data-nav-mode>Current lens / Understand</span>
      </div>
      <nav class="nav-index" aria-label="Site sections">
        {routes.map((route) => (
          <a
            href={route.href}
            class="nav-index__link"
            data-site-link={route.id}
            aria-current={route.id === activePage ? "page" : undefined}
          >
            <span>{route.title}</span>
            <small>{route.note}</small>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-5-5 5 5-5 5"></path></svg>
          </a>
        ))}
      </nav>
      <aside class="nav-dialog__aside">
        <svg viewBox="0 0 128 128" aria-hidden="true">
          <path d="M18 64h34m24 0h34M52 64c19 0 9-35 29-35h14M52 64c19 0 9 35 29 35h14" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          <circle cx="18" cy="64" r="4" fill="currentColor"></circle><circle cx="52" cy="64" r="4" fill="currentColor"></circle>
          <circle cx="81" cy="29" r="4" fill="currentColor"></circle><circle cx="81" cy="99" r="4" fill="currentColor"></circle><circle cx="110" cy="64" r="4" fill="currentColor"></circle>
        </svg>
        <p>A map is only a guess about where the interesting part begins.</p>
        <span>FIELD NOTE / 001</span>
      </aside>
    </div>
    <div class="nav-dialog__footer">
      <span>Build. Break. Understand.</span><span>Choose your own route.</span>
    </div>
  </div>
</dialog>
