---
interface Props {
  title: string;
  lede: string;
  index: string;
  variant?: string;
}

const { title, lede, index, variant = "" } = Astro.props;
---

<header class:list={["route-intro", "page-grid", variant]} id="top">
  <div class="route-intro__copy">
    <h1 class="page-title">{title}</h1>
    <p class="page-lede">{lede}</p>
  </div>
  <p class="route-index-note">{index}</p>
</header>
